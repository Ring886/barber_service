# Docker Compose ports
API_PORT=8080
MYSQL_PORT=3306

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=barber_booking
MYSQL_USERNAME=barber_booking
MYSQL_PASSWORD=barber_booking_password

# Spring Boot datasource
MYSQL_URL=jdbc:mysql://localhost:3306/barber_booking?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
